#!/usr/bin/env python3
import json
import sys

request = json.load(sys.stdin)
if request.get("protocol_version") != 1:
    print(json.dumps({"ok": False, "error": "unsupported protocol version"}))
    raise SystemExit(0)

operation = request.get("operation")
config = request.get("configuration") or {}
if operation == "describe":
    result = {
        "id": "example.sbom-release-diff",
        "version": "0.1.0",
        "protocol_version": 1,
        "collectors": ["release-diff"],
        "evaluators": [], "evaluator_inputs": {}, "evaluator_propositions": {},
        "source_contracts": ["sbom-diff-output/v1"],
        "configuration_schema": {
            "required": ["repository", "release", "base_release", "executable", "base_sbom", "target_sbom", "observed_at"]
        }
    }
elif operation == "collect":
    result = {
        "adapter": "pack-sbom-diff",
        "subject": {
            "kind": "release",
            "id": config["repository"] + ":" + config["release"],
            "repository": config["repository"],
            "release": config["release"],
            "base_release": config["base_release"],
            "revision": config["revision"],
            "base_revision": config["base_revision"]
        },
        "observed_at": config["observed_at"],
        "command": {
            "tool_name": "sbom-diff",
            "reported_version": config.get("tool_version"),
            "executable": config["executable"],
            "argv": [config["base_sbom"], config["target_sbom"], "-o", "json"],
            "inputs": {"base": config["base_sbom"], "target": config["target_sbom"]}
        }
    }
elif operation == "normalize":
    payload = json.loads(request["input"]["source"]["content"])
    result = {
        "claim_key": "sbom-diff:dependency-change",
        "data": {
            "components": {"added": payload["added"], "removed": payload["removed"], "changed": payload["changed"]},
            "counts": {
                "added": len(payload["added"]), "removed": len(payload["removed"]),
                "changed": len(payload["changed"]), "dependency_edges_changed": len(payload.get("edge_diffs", [])),
                "old_total": payload["old_total"], "new_total": payload["new_total"], "unchanged": payload["unchanged"]
            },
            "metadata_changed": payload.get("metadata_changed")
        },
        "evidence_class": "observed_state",
        "kind": "change_set",
        "severity": None,
        "status": None
    }
else:
    print(json.dumps({"ok": False, "error": "unsupported operation"}))
    raise SystemExit(0)

print(json.dumps({"ok": True, "result": result}, separators=(",", ":")))
