#!/usr/bin/env python3
"""collect and evaluate a repository's exact Cargo.lock dependency inventory."""

import hashlib
import json
import os
import sys


PACK_ID = "cyberwitchery.cargo-lock"
PACK_VERSION = "0.1.0"


def fail(message):
    print(json.dumps({"ok": False, "error": message}, separators=(",", ":")))
    raise SystemExit(0)


def reply(result):
    print(json.dumps({"ok": True, "result": result}, separators=(",", ":")))


def field(lines, name, required=False):
    prefix = name + " = "
    for line in lines:
        if line.startswith(prefix):
            try:
                value = json.loads(line[len(prefix):])
            except json.JSONDecodeError:
                fail("Cargo.lock has an invalid " + name + " field")
            if not isinstance(value, str):
                fail("Cargo.lock " + name + " must be a string")
            return value
    if required:
        fail("Cargo.lock package is missing " + name)
    return None


def snapshot(path):
    try:
        with open(path, "rb") as handle:
            content = handle.read()
    except OSError as error:
        fail("cannot read Cargo.lock: " + str(error))
    try:
        text = content.decode("utf-8")
    except UnicodeDecodeError:
        fail("Cargo.lock is not utf-8")

    format_version = None
    for line in text.splitlines():
        if line.startswith("version = "):
            try:
                format_version = int(line[len("version = "):])
            except ValueError:
                fail("Cargo.lock format version is invalid")
            break
    if format_version is None:
        fail("Cargo.lock has no format version")

    packages = []
    for section in text.split("[[package]]")[1:]:
        lines = [line.strip() for line in section.splitlines() if line.strip()]
        package = {
            "name": field(lines, "name", required=True),
            "version": field(lines, "version", required=True),
        }
        for name in ("source", "checksum"):
            value = field(lines, name)
            if value is not None:
                package[name] = value
        packages.append(package)
    if not packages:
        fail("Cargo.lock contains no packages")
    packages.sort(key=lambda item: (item["name"], item["version"], item.get("source", "")))
    print(json.dumps({
        "format_version": format_version,
        "lockfile_sha256": hashlib.sha256(content).hexdigest(),
        "packages": packages,
    }, separators=(",", ":")))


def repository_path(context, relative):
    if not isinstance(relative, str) or not relative:
        fail("configuration.path must be a non-empty string")
    root = os.path.realpath(context["repository_path"])
    target = os.path.realpath(os.path.join(root, relative))
    try:
        inside = os.path.commonpath([root, target]) == root
    except ValueError:
        inside = False
    if not inside:
        fail("configuration.path must remain inside the repository")
    if not os.path.isfile(target):
        fail("configured Cargo.lock does not exist: " + relative)
    return target


if len(sys.argv) == 3 and sys.argv[1] == "snapshot":
    snapshot(sys.argv[2])
    raise SystemExit(0)

try:
    request = json.load(sys.stdin)
except (json.JSONDecodeError, UnicodeDecodeError):
    fail("request is not valid json")
if request.get("protocol_version") != 1:
    fail("unsupported protocol version")

operation = request.get("operation")
if operation == "describe":
    reply({
        "id": PACK_ID,
        "version": PACK_VERSION,
        "protocol_version": 1,
        "collectors": ["lockfile"],
        "evaluators": ["lockfile-captured"],
        "evaluator_inputs": {"lockfile-captured": ["cargo:dependency-lock"]},
        "evaluator_propositions": {"lockfile-captured": []},
        "source_contracts": [],
        "configuration_schema": {},
    })
elif operation == "collect":
    collection = request.get("input") or {}
    if collection.get("collector") != "lockfile":
        fail("unsupported collector")
    context = collection.get("context") or {}
    configuration = context.get("configuration") or {}
    path = repository_path(context, configuration.get("path", "Cargo.lock"))
    subject = {
        "kind": "repository",
        "id": context["repository"],
        "repository": context["repository"],
        "branch": context["branch"],
        "revision": context["revision"],
    }
    reply({
        "adapter": "cargo-lock/v1",
        "subject": subject,
        "observed_at": context["observed_at"],
        "command": {
            "tool_name": "divinate-cargo-lock-snapshot",
            "reported_version": PACK_VERSION,
            "executable": os.path.realpath(__file__),
            "argv": ["snapshot", path],
            "inputs": {"cargo_lock": path},
        },
    })
elif operation == "normalize":
    source = (request.get("input") or {}).get("source") or {}
    try:
        payload = json.loads(source.get("content", ""))
    except json.JSONDecodeError:
        fail("snapshot output is not valid json")
    packages = payload.get("packages")
    if not isinstance(packages, list) or not packages:
        fail("snapshot output contains no packages")
    reply({
        "claim_key": "cargo:dependency-lock",
        "data": payload,
        "evidence_class": "observed_state",
        "kind": "configuration_snapshot",
        "severity": None,
        "status": "pass",
    })
elif operation == "evaluate":
    evaluation = request.get("input") or {}
    target = evaluation.get("target") or {}
    observations = ((evaluation.get("corpus") or {}).get("observations") or [])
    matching = [item for item in observations
                if item.get("claim_key") == "cargo:dependency-lock"
                and (item.get("subject") or {}).get("repository") == target.get("repository")
                and (item.get("subject") or {}).get("branch") == target.get("branch")]
    matching.sort(key=lambda item: (item.get("observed_at", ""), item.get("id", "")))
    source = matching[-1] if matching else None
    support = [] if source is None else [{
        "observation_id": source["id"],
        "source_id": source["provenance"]["source_id"],
        "reason": "the retained Cargo.lock snapshot was parsed into a dependency inventory",
    }]
    missing = [] if source is not None else [{
        "requirement": "a retained and parsed Cargo.lock snapshot",
        "subject": target["repository"],
        "reason": "no matching cargo dependency lock observation exists",
    }]
    reply([{
        "assertion_type": "cargo_dependency_lock_captured",
        "claim": "repository dependency resolution is recorded in Cargo.lock",
        "subject": {
            "repository": target["repository"],
            "branch": target["branch"],
            "release": None,
            "from": None,
            "until": None,
        },
        "outcome": "supported" if source is not None else "insufficient_evidence",
        "evaluated_at": evaluation["evaluated_at"],
        "validity": {
            "basis": "point_in_time",
            "at": evaluation["evaluated_at"],
            "from": None,
            "through": None,
            "fresh_until": None,
        },
        "support": support,
        "contradictions": [],
        "considered": [],
        "missing": missing,
        "identity_joins": [],
        "reasoning": [],
        "limitations": [
            "Cargo.lock records resolved dependencies; it does not establish which code was built or deployed"
        ],
        "coverage": [],
    }])
else:
    fail("unsupported operation")
