#!/usr/bin/env python3
"""plan and interpret the narrow github evidence used by divinate."""

import json
import sys


PACK_ID = "cyberwitchery.github"
PACK_VERSION = "0.1.0"


def fail(message):
    print(json.dumps({"ok": False, "error": message}, separators=(",", ":")))
    raise SystemExit(0)


def reply(result):
    print(json.dumps({"ok": True, "result": result}, separators=(",", ":")))


def subject(context):
    return {
        "kind": "repository",
        "id": context["repository"],
        "repository": context["repository"],
        "branch": context["branch"],
        "revision": context["revision"],
    }


def normalize_branch(payload, branch):
    if isinstance(payload.get("protected"), bool):
        if payload["protected"]:
            return {
                "claim_key": "github:branch-state",
                "data": {"branch": branch, "protected": True},
                "evidence_class": "configured_intent",
                "kind": "configuration_snapshot",
                "severity": None,
                "status": None,
            }
        data = {
            "allows_deletions": False,
            "allows_force_pushes": False,
            "dismisses_stale_reviews": False,
            "enforces_admins": False,
            "requires_code_owner_reviews": False,
            "requires_last_push_approval": False,
            "required_approving_review_count": 0,
            "required_status_checks": [],
            "requires_strict_status_checks": False,
        }
    else:
        reviews = payload.get("required_pull_request_reviews") or {}
        status_checks = payload.get("required_status_checks") or {}
        contexts = list(status_checks.get("contexts") or [])
        contexts.extend(item.get("context") for item in status_checks.get("checks") or [])
        data = {
            "allows_deletions": bool((payload.get("allow_deletions") or {}).get("enabled", False)),
            "allows_force_pushes": bool((payload.get("allow_force_pushes") or {}).get("enabled", False)),
            "dismisses_stale_reviews": bool(reviews.get("dismiss_stale_reviews", False)),
            "enforces_admins": bool((payload.get("enforce_admins") or {}).get("enabled", False)),
            "requires_code_owner_reviews": bool(reviews.get("require_code_owner_reviews", False)),
            "requires_last_push_approval": bool(reviews.get("require_last_push_approval", False)),
            "required_approving_review_count": int(reviews.get("required_approving_review_count", 0)),
            "required_status_checks": sorted(set(item for item in contexts if isinstance(item, str))),
            "requires_strict_status_checks": bool(status_checks.get("strict", False)),
        }
    return {
        "claim_key": "github:branch-protection",
        "data": data,
        "evidence_class": "configured_intent",
        "kind": "configuration_snapshot",
        "severity": None,
        "status": None,
    }


def normalize_checks(payload, revision):
    runs = payload.get("check_runs")
    if not isinstance(runs, list):
        fail("github check-runs response has no check_runs array")
    checks = []
    for run in runs:
        if not isinstance(run, dict) or not isinstance(run.get("name"), str):
            fail("github check-runs response contains an invalid check run")
        checks.append({
            "name": run["name"],
            "status": run.get("status"),
            "conclusion": run.get("conclusion"),
            "head_sha": run.get("head_sha"),
        })
    checks.sort(key=lambda item: (item["name"], item.get("head_sha") or ""))
    return {
        "claim_key": "github:check-runs",
        "data": {
            "revision": revision,
            "total_count": payload.get("total_count"),
            "checks": checks,
        },
        "evidence_class": "observed_state",
        "kind": "policy_check",
        "severity": None,
        "status": None,
    }


def normalize_statuses(payload, revision):
    statuses = payload.get("statuses")
    if not isinstance(statuses, list):
        fail("github combined-status response has no statuses array")
    normalized = []
    for status in statuses:
        if not isinstance(status, dict) or not isinstance(status.get("context"), str):
            fail("github combined-status response contains an invalid commit status")
        normalized.append({
            "context": status["context"],
            "state": status.get("state"),
        })
    normalized.sort(key=lambda item: item["context"].casefold())
    return {
        "claim_key": "github:commit-statuses",
        "data": {
            "revision": revision,
            "total_count": payload.get("total_count"),
            "statuses": normalized,
        },
        "evidence_class": "observed_state",
        "kind": "policy_check",
        "severity": None,
        "status": None,
    }


def evidence_use(observation, reason):
    return {
        "observation_id": observation["id"],
        "source_id": observation["provenance"]["source_id"],
        "reason": reason,
    }


def quantity(count, singular, plural=None):
    plural = plural or f"{singular}s"
    if count == 0:
        return f"no {plural}"
    return f"{count} {singular if count == 1 else plural}"


def assertion_base(assertion_type, claim, evaluation, coverage):
    target = evaluation["target"]
    return {
        "assertion_type": assertion_type,
        "claim": claim,
        "subject": {
            "repository": target["repository"],
            "branch": target["branch"],
            "release": None,
            "from": target["from"],
            "until": target["until"],
        },
        "outcome": "insufficient_evidence",
        "evaluated_at": evaluation["evaluated_at"],
        "validity": {
            "basis": "point_in_time",
            "at": evaluation["evaluated_at"],
            "from": None,
            "through": None,
            "fresh_until": None,
        },
        "support": [],
        "contradictions": [],
        "considered": [],
        "missing": [],
        "identity_joins": [],
        "reasoning": [],
        "limitations": [],
        "coverage": [],
    }


def latest(observations, key, target):
    matching = [item for item in observations
                if item.get("claim_key") == key
                and (item.get("subject") or {}).get("id") == target["repository"]
                and (item.get("subject") or {}).get("branch") == target["branch"]]
    if not matching:
        return []
    observed_at = max(item.get("observed_at", "") for item in matching)
    return [item for item in matching if item.get("observed_at") == observed_at]


def complete_authoritative_run(evaluation, observations):
    if not observations:
        return False
    runs = {item.get("id"): item
            for item in (evaluation.get("corpus") or {}).get("collections") or []}
    for observation in observations:
        run = runs.get(observation.get("collection_run_id"))
        enumeration = (run or {}).get("enumeration") or {}
        if (not run
                or run.get("outcome") != "complete"
                or "revision_checks" not in (run.get("authority") or [])
                or not enumeration.get("terminal_page_reached")
                or enumeration.get("next_token_present")):
            return False
    return True


def evaluate_required_checks(evaluation):
    coverage = evaluation["coverage"][0]
    observations = latest(
        (evaluation.get("corpus") or {}).get("observations") or [],
        "github:branch-protection",
        evaluation["target"],
    )
    result = assertion_base(
        "github_required_status_checks_configured",
        "the protected branch requires named status checks",
        evaluation,
        coverage,
    )
    if not observations:
        result["missing"].append({
            "requirement": "current github branch protection configuration",
            "subject": evaluation["target"]["repository"],
            "reason": "no authoritative branch protection snapshot is available",
        })
        return result
    observation = observations[-1]
    checks = observation["data"].get("required_status_checks") or []
    use = evidence_use(observation, "GitHub reported the branch's required status checks")
    if checks:
        result["outcome"] = "supported" if coverage["outcome"] == "complete" else "insufficient_evidence"
        result["support"].append(use)
    else:
        result["outcome"] = "contradicted"
        result["contradictions"].append(use)
    return result


def evaluate_current_checks(evaluation):
    corpus_observations = (evaluation.get("corpus") or {}).get("observations") or []
    check_observations = latest(
        corpus_observations,
        "github:check-runs",
        evaluation["target"],
    )
    status_observations = latest(
        corpus_observations,
        "github:commit-statuses",
        evaluation["target"],
    )
    result = assertion_base(
        "github_current_revision_checks_passed",
        (
            "GitHub check runs and commit statuses for the current revision were "
            "completely enumerated and had acceptable terminal outcomes"
        ),
        evaluation,
        evaluation["coverage"][0],
    )
    result["limitations"] = [
        "this assertion covers observed results, not satisfaction of configured required contexts",
        "this point-in-time result does not establish historical CI policy enforcement",
    ]

    checks = [check for item in check_observations
              for check in item["data"].get("checks", [])]
    statuses = [status for item in status_observations
                for status in item["data"].get("statuses", [])]
    failed_checks = [check for check in checks
                     if check.get("status") == "completed"
                     and check.get("conclusion") in (
                         "failure", "cancelled", "timed_out", "action_required",
                         "stale", "startup_failure")]
    failed_statuses = [status for status in statuses
                       if status.get("state") in ("failure", "error")]
    unresolved_checks = [check for check in checks
                         if check.get("status") != "completed"
                         or check.get("conclusion") not in (
                             "success", "neutral", "skipped", "failure",
                             "cancelled", "timed_out", "action_required",
                             "stale", "startup_failure")]
    unresolved_statuses = [status for status in statuses
                           if status.get("state") not in ("success", "failure", "error")]
    check_uses = [evidence_use(item, "GitHub reported check runs for the current revision")
                  for item in check_observations]
    status_uses = [evidence_use(
                       item,
                       "GitHub reported classic commit statuses for the current revision",
                   )
                   for item in status_observations]
    uses = check_uses + status_uses
    checks_complete = complete_authoritative_run(evaluation, check_observations)
    statuses_complete = complete_authoritative_run(evaluation, status_observations)
    check_revisions = {(item.get("subject") or {}).get("revision")
                       for item in check_observations}
    status_revisions = {(item.get("subject") or {}).get("revision")
                        for item in status_observations}
    same_revision = (len(check_revisions) == 1
                     and check_revisions == status_revisions
                     and None not in check_revisions)
    evidence_ids = [item["id"] for item in check_observations + status_observations]
    reported_checks = quantity(len(checks), "check run")
    reported_statuses = quantity(
        len(statuses), "classic commit status", "classic commit statuses")
    failed_check_count = quantity(len(failed_checks), "check run")
    failed_status_count = quantity(
        len(failed_statuses), "commit status", "commit statuses")

    if same_revision and (failed_checks or failed_statuses):
        result["outcome"] = "contradicted"
        result["contradictions"] = uses
        result["reasoning"].append({
            "code": "github_revision_result_failure",
            "conclusion": (
                f"GitHub reported {reported_checks} and {reported_statuses}; "
                f"{failed_check_count} and {failed_status_count} had failing terminal outcomes"
            ),
            "evidence_ids": evidence_ids,
        })
    elif (not checks and not statuses) or unresolved_checks or unresolved_statuses \
            or not checks_complete or not statuses_complete or not same_revision:
        result["considered"] = uses
        if not check_observations or not status_observations:
            unavailable = []
            if not check_observations:
                unavailable.append("check-run")
            if not status_observations:
                unavailable.append("commit-status")
            reason = f"GitHub {' and '.join(unavailable)} evidence was unavailable"
        elif not same_revision:
            reason = "check-run and commit-status evidence did not resolve to the same revision"
        elif not checks and not statuses:
            reason = (
                "GitHub completely enumerated check runs and classic commit statuses "
                "but reported no CI results"
            )
        elif not checks_complete or not statuses_complete:
            incomplete = []
            if not checks_complete:
                incomplete.append("check-run")
            if not statuses_complete:
                incomplete.append("commit-status")
            reason = f"GitHub {' and '.join(incomplete)} enumeration was incomplete"
        else:
            unresolved_check_count = quantity(len(unresolved_checks), "check run")
            unresolved_status_count = quantity(
                len(unresolved_statuses), "commit status", "commit statuses")
            reason = (
                f"GitHub reported {unresolved_check_count} and {unresolved_status_count} "
                "with pending, transitional, or unrecognized outcomes"
            )
        result["missing"].append({
            "requirement": "complete terminal GitHub check runs and commit statuses",
            "subject": evaluation["target"]["repository"],
            "reason": reason,
        })
        result["reasoning"].append({
            "code": "github_revision_results_incomplete",
            "conclusion": reason,
            "evidence_ids": evidence_ids,
        })
    else:
        result["outcome"] = "supported"
        result["support"] = uses
        result["reasoning"].append({
            "code": "github_revision_results_acceptable",
            "conclusion": (
                f"GitHub reported {reported_checks} and {reported_statuses}; both "
                "enumerations were complete and every result had an acceptable terminal outcome"
            ),
            "evidence_ids": evidence_ids,
        })
        result["identity_joins"].append({
            "left_observation_id": check_observations[0]["id"],
            "right_observation_id": status_observations[0]["id"],
            "fields": {"revision": next(iter(check_revisions))},
        })
    return result


try:
    request = json.load(sys.stdin)
except (json.JSONDecodeError, UnicodeDecodeError):
    fail("request is not valid json")
if request.get("protocol_version") != 1:
    fail("unsupported protocol version")

operation = request.get("operation")
if operation == "describe":
    reply({
        "id": PACK_ID,
        "version": PACK_VERSION,
        "protocol_version": 1,
        "collectors": ["branch-protection", "check-runs", "commit-statuses"],
        "evaluators": ["required-status-checks", "current-revision-checks"],
        "evaluator_inputs": {
            "required-status-checks": ["github:branch-protection"],
            "current-revision-checks": ["github:check-runs", "github:commit-statuses"],
        },
        "evaluator_propositions": {
            "required-status-checks": ["branch_configuration"],
            "current-revision-checks": ["revision_checks"],
        },
        "source_contracts": ["github-branch-protection/v1", "github-check-runs/v1", "github-commit-statuses/v1"],
        "configuration_schema": {},
    })
elif operation == "collect":
    collection = request.get("input") or {}
    collector = collection.get("collector")
    context = collection.get("context") or {}
    if collector not in ("branch-protection", "check-runs", "commit-statuses"):
        fail("unsupported collector")
    adapters = {
        "branch-protection": "github-branch-protection/v1",
        "check-runs": "github-check-runs/v1",
        "commit-statuses": "github-commit-statuses/v1",
    }
    resources = {
        "branch-protection": "branch_protection",
        "check-runs": "check_runs",
        "commit-statuses": "commit_statuses",
    }
    reply({
        "adapter": adapters[collector],
        "subject": subject(context),
        "observed_at": context["observed_at"],
        "acquisition": {
            "provider": "github",
            "resource": resources[collector],
            "per_page": 100,
            "max_pages": 10,
        },
    })
elif operation == "normalize":
    source = (request.get("input") or {}).get("source") or {}
    try:
        payload = json.loads(source.get("content", ""))
    except json.JSONDecodeError:
        fail("github response is not valid json")
    source_subject = (request.get("input") or {}).get("subject") or {}
    adapter = (request.get("input") or {}).get("adapter")
    if adapter == "github-branch-protection/v1":
        reply(normalize_branch(payload, source_subject.get("branch")))
    elif adapter == "github-check-runs/v1":
        reply(normalize_checks(payload, source_subject.get("revision")))
    elif adapter == "github-commit-statuses/v1":
        reply(normalize_statuses(payload, source_subject.get("revision")))
    else:
        fail("unsupported adapter")
elif operation == "evaluate":
    evaluation = request.get("input") or {}
    evaluator = evaluation.get("evaluator")
    if evaluator == "required-status-checks":
        reply([evaluate_required_checks(evaluation)])
    elif evaluator == "current-revision-checks":
        reply([evaluate_current_checks(evaluation)])
    else:
        fail("unsupported evaluator")
else:
    fail("unsupported operation")
