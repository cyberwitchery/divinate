#!/usr/bin/env python3
import json
import sys

request = json.load(sys.stdin)
if request.get("protocol_version") != 1:
    print(json.dumps({"ok": False, "error": "unsupported protocol version"}))
    raise SystemExit(0)
operation = request.get("operation")
config = request.get("configuration") or {}
if operation == "describe":
    result = {
        "id": "example.backup-control", "version": "0.1.0", "protocol_version": 1,
        "collectors": ["backup-encryption"], "evaluators": [], "evaluator_inputs": {}, "evaluator_propositions": {},
        "source_contracts": ["internal-backup-config/v1"],
        "configuration_schema": {"required": ["repository", "source_command", "observed_at"]}
    }
elif operation == "collect":
    result = {
        "adapter": "backup-config",
        "subject": {"kind": "repository", "id": config["repository"], "repository": config["repository"]},
        "observed_at": config["observed_at"],
        "command": {
            "tool_name": "internal-backup-config", "reported_version": "1",
            "executable": config["source_command"], "argv": config.get("source_argv", []), "inputs": {}
        }
    }
elif operation == "normalize":
    payload = json.loads(request["input"]["source"]["content"])
    enabled = payload.get("encrypted") is True
    result = {
        "claim_key": "internal:backup-encryption", "data": {"encrypted": enabled},
        "evidence_class": "configured_intent", "kind": "configuration_snapshot",
        "severity": None, "status": "pass" if enabled else "fail"
    }
else:
    print(json.dumps({"ok": False, "error": "unsupported operation"}))
    raise SystemExit(0)
print(json.dumps({"ok": True, "result": result}, separators=(",", ":")))
