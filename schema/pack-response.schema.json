{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pack-response.schema.json",
  "title": "divinate pack response",
  "description": "the one json document a pack writes to stdout for a request described by pack-protocol.schema.json. the root accepts any operation; $defs/describe, collect, normalize, and evaluate type the result of each.",
  "$ref": "#/$defs/envelope",
  "$defs": {
    "envelope": {
      "type":"object","additionalProperties":false,"required":["ok"],
      "properties": {
        "ok":{"type":"boolean"},
        "result":{"description":"read only when ok is true"},
        "error":{"type":["string","null"],"description":"read only when ok is false"}
      },
      "if":{"properties":{"ok":{"const":true}}},
      "then":{"required":["result"],"properties":{"result":{"not":{"type":"null"}}}}
    },
    "describe": {"$ref":"#/$defs/envelope","if":{"properties":{"ok":{"const":true}}},"then":{"properties":{"result":{"$ref":"#/$defs/pack_metadata"}}}},
    "collect": {"$ref":"#/$defs/envelope","if":{"properties":{"ok":{"const":true}}},"then":{"properties":{"result":{"$ref":"#/$defs/collection_plan"}}}},
    "normalize": {"$ref":"#/$defs/envelope","if":{"properties":{"ok":{"const":true}}},"then":{"properties":{"result":{"$ref":"#/$defs/normalized_observation"}}}},
    "evaluate": {"$ref":"#/$defs/envelope","if":{"properties":{"ok":{"const":true}}},"then":{"properties":{"result":{"type":"array","items":{"$ref":"#/$defs/pack_assertion"}}}}},
    "pack_metadata": {
      "type":"object","additionalProperties":false,"required":["id","version","protocol_version"],
      "properties": {
        "id":{"type":"string","pattern":"\\S"},
        "version":{"type":"string","pattern":"\\S"},
        "protocol_version":{"const":1},
        "collectors":{"type":"array","items":{"type":"string"}},
        "evaluators":{"type":"array","items":{"type":"string"}},
        "evaluator_inputs":{"type":"object","description":"the claim keys each evaluator receives","additionalProperties":{"type":"array","items":{"type":"string"}}},
        "evaluator_propositions":{"type":"object","description":"the collection runs each evaluator receives and the coverage core requires of it","additionalProperties":{"type":"array","items":{"$ref":"#/$defs/proposition"}}},
        "source_contracts":{"type":"array","items":{"type":"string"}},
        "configuration_schema":{},
        "compatibility":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/pack_compatibility"}]}
      }
    },
    "pack_compatibility": {
      "type":"object","additionalProperties":false,"required":["core","control_definition_version"],
      "properties": {
        "core":{"type":"string","description":"comma-separated clauses such as \">=0.1.0, <0.2.0\"; core refuses a pack whose range excludes it"},
        "control_definition_version":{"type":"string","pattern":"\\S"},
        "providers":{"type":"array","items":{"type":"string"}},
        "source_contracts":{"type":"array","items":{"type":"string"}},
        "control_ids":{"type":"array","items":{"type":"string","pattern":"\\S"}}
      }
    },
    "collection_plan": {
      "type":"object","additionalProperties":false,"required":["adapter","subject","observed_at"],
      "description":"exactly one of command and acquisition is set",
      "properties": {
        "adapter":{"type":"string"},
        "subject":{"$ref":"pack-protocol.schema.json#/$defs/subject"},
        "observed_at":{"type":"string","format":"date-time"},
        "command":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/command_plan"}]},
        "acquisition":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/remote_acquisition_plan"}]}
      },
      "oneOf": [
        {"required":["command"],"properties":{"command":{"type":"object"},"acquisition":{"type":"null"}}},
        {"required":["acquisition"],"properties":{"acquisition":{"type":"object"},"command":{"type":"null"}}}
      ]
    },
    "command_plan": {
      "type":"object","additionalProperties":false,"required":["tool_name","executable"],
      "properties": {
        "tool_name":{"type":"string"},
        "reported_version":{"type":["string","null"]},
        "executable":{"type":"string"},
        "argv":{"type":"array","items":{"type":"string"}},
        "inputs":{"type":"object","description":"named input files core retains with the execution","additionalProperties":{"type":"string"}}
      }
    },
    "remote_acquisition_plan": {
      "oneOf": [
        {
          "type":"object","additionalProperties":false,"required":["provider","resource"],
          "properties": {
            "provider":{"const":"github"},
            "resource":{"enum":["branch_protection","check_runs","commit_statuses","repository_mutations","pull_request_reviews","build_validation_history"]},
            "per_page":{"type":"integer","minimum":0,"maximum":65535,"default":100},
            "max_pages":{"type":"integer","minimum":0,"maximum":65535,"default":10}
          }
        },
        {
          "type":"object","additionalProperties":false,"required":["provider","resource"],
          "properties": {
            "provider":{"const":"azure_devops"},
            "resource":{"enum":["branch_policy","repository_mutations","pull_request_reviews","build_validation_history"]},
            "max_pages":{"type":"integer","minimum":0,"maximum":65535,"default":10}
          }
        }
      ]
    },
    "normalized_observation": {
      "type":"object","additionalProperties":false,"required":["claim_key","data","evidence_class","kind"],
      "properties": {
        "claim_key":{"type":"string"},
        "data":{},
        "evidence_class":{"enum":["configured_intent","observed_operation","observed_state"]},
        "kind":{"enum":["change_set","configuration_history","configuration_snapshot","mutation_history","policy_check","release_membership","review_record","validation_record"]},
        "severity":{"enum":["info","low","medium","high","critical",null]},
        "status":{"enum":["pass","fail","warning","unknown",null]}
      }
    },
    "pack_assertion": {
      "type":"object","additionalProperties":false,
      "required":["assertion_type","claim","subject","outcome","evaluated_at","validity","support","contradictions","considered","missing","identity_joins","reasoning","limitations","coverage"],
      "description":"core assigns id and derivation; a pack that sends them is refused",
      "properties": {
        "assertion_type":{"type":"string"},
        "claim":{"type":"string"},
        "subject":{
          "type":"object","required":["repository"],
          "properties": {
            "repository":{"type":"string"},
            "branch":{"type":["string","null"]},
            "release":{"type":["string","null"]},
            "from":{"type":["string","null"],"format":"date-time"},
            "until":{"type":["string","null"],"format":"date-time"}
          }
        },
        "outcome":{"enum":["supported","contradicted","insufficient_evidence","stale","not_automatable"]},
        "evaluated_at":{"type":"string","format":"date-time"},
        "validity":{
          "type":"object","required":["basis"],
          "properties": {
            "basis":{"enum":["point_in_time","historical_release","not_established"]},
            "at":{"type":["string","null"],"format":"date-time"},
            "from":{"type":["string","null"],"format":"date-time"},
            "through":{"type":["string","null"],"format":"date-time"},
            "fresh_until":{"type":["string","null"],"format":"date-time"}
          }
        },
        "support":{"type":"array","items":{"$ref":"#/$defs/evidence_use"}},
        "contradictions":{"type":"array","items":{"$ref":"#/$defs/evidence_use"}},
        "considered":{"type":"array","items":{"$ref":"#/$defs/evidence_use"}},
        "missing":{"type":"array","items":{"type":"object","required":["requirement","subject","reason"],"properties":{"requirement":{"type":"string"},"subject":{"type":"string"},"reason":{"type":"string"}}}},
        "identity_joins":{"type":"array","items":{"type":"object","required":["left_observation_id","right_observation_id","fields"],"properties":{"left_observation_id":{"type":"string"},"right_observation_id":{"type":"string"},"fields":{"type":"object","additionalProperties":{"type":"string"}}}}},
        "reasoning":{"type":"array","items":{"type":"object","required":["code","conclusion","evidence_ids"],"properties":{"code":{"type":"string"},"conclusion":{"type":"string"},"evidence_ids":{"type":"array","items":{"type":"string"}}}}},
        "limitations":{"type":"array","items":{"type":"string"}},
        "coverage":{"type":"array","items":{"$ref":"#/$defs/coverage"}}
      }
    },
    "evidence_use": {
      "type":"object","required":["observation_id","source_id","reason"],
      "properties": {
        "observation_id":{"type":"string"},
        "source_id":{"type":"string"},
        "reason":{"type":"string"},
        "review":{"type":"null","description":"core derives review details; a pack that supplies them is refused"}
      }
    },
    "coverage": {
      "type":"object","required":["requirement","outcome","covered_intervals","uncovered_intervals","collection_runs"],
      "description":"must equal core's own decision for the proposition",
      "properties": {
        "requirement":{"type":"object","required":["proposition","repository","interval"],"properties":{"proposition":{"$ref":"#/$defs/proposition"},"repository":{"type":"string"},"branch":{"type":["string","null"]},"interval":{"$ref":"#/$defs/interval"}}},
        "outcome":{"enum":["complete","incomplete"]},
        "covered_intervals":{"type":"array","items":{"$ref":"#/$defs/interval"}},
        "uncovered_intervals":{"type":"array","items":{"$ref":"#/$defs/interval"}},
        "collection_runs":{"type":"array","items":{
          "type":"object","required":["collection_run_id","disposition","reason"],
          "properties":{"collection_run_id":{"type":"string"},"disposition":{"enum":["used","scope_mismatch","not_authoritative","pagination_incomplete","permission_denied","retention_limited","interrupted","failed","not_attempted"]},"reason":{"type":"string"},"contributed_interval":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/interval"}]}}
        }}
      }
    },
    "interval": {"type":"object","required":["from","until"],"properties":{"from":{"type":"string","format":"date-time"},"until":{"type":"string","format":"date-time"}}},
    "proposition": {"enum":["pull_request_population","pull_request_reviews","repository_mutations","commit_ancestry","branch_configuration","revision_checks","build_validation_results","supply_chain_policy_decision","declared_dependencies"]}
  }
}
