{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pack-protocol.schema.json",
  "title": "divinate pack request",
  "description": "the one json document core writes to a pack's stdin. input depends on operation. the pack answers with one document described by pack-response.schema.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "operation", "configuration", "input"],
  "properties": {
    "protocol_version": {"const":1},
    "operation": {"enum":["describe","collect","normalize","evaluate"]},
    "configuration": {"description":"the pack's config mapping from divinate.yaml, verbatim; {} when it sets none"},
    "input": {}
  },
  "allOf": [
    {"if":{"properties":{"operation":{"const":"describe"}}},"then":{"properties":{"input":{"$ref":"#/$defs/describe_input"}}}},
    {"if":{"properties":{"operation":{"const":"collect"}}},"then":{"properties":{"input":{"$ref":"#/$defs/collect_input"}}}},
    {"if":{"properties":{"operation":{"const":"normalize"}}},"then":{"properties":{"input":{"$ref":"#/$defs/normalize_input"}}}},
    {"if":{"properties":{"operation":{"const":"evaluate"}}},"then":{"properties":{"input":{"$ref":"#/$defs/evaluate_input"}}}}
  ],
  "$defs": {
    "describe_input": {"type":"null"},
    "collect_input": {
      "type":"object","additionalProperties":false,"required":["collector","context"],
      "properties": {
        "collector":{"type":"string","description":"one of the collectors the pack declared in describe"},
        "context":{"description":"for a configured source, a source_context; for `divinate collect pack`, the --context file verbatim, or null without one"}
      }
    },
    "source_collect": {
      "description":"the collect request for a configured source",
      "$ref":"#","properties":{"operation":{"const":"collect"},"input":{"properties":{"context":{"$ref":"#/$defs/source_context"}}}}
    },
    "source_context": {
      "type":"object","additionalProperties":false,
      "required":["repository","branch","revision","repository_path","interval","observed_at","release","configuration"],
      "properties": {
        "repository":{"type":"string"},
        "branch":{"type":"string"},
        "revision":{"type":"string","description":"the repository's HEAD commit"},
        "repository_path":{"type":"string"},
        "interval":{"$ref":"#/$defs/interval"},
        "observed_at":{"type":"string","format":"date-time"},
        "release":{
          "description":"null unless the source sets context: release",
          "oneOf":[
            {"type":"null"},
            {"type":"object","additionalProperties":false,"required":["release","revision","previous_release","previous_revision"],"properties":{"release":{"type":"string"},"revision":{"type":"string"},"previous_release":{"type":"string"},"previous_revision":{"type":"string"}}}
          ]
        },
        "configuration":{"description":"the source's config from divinate.yaml"}
      }
    },
    "normalize_input": {
      "type":"object","additionalProperties":false,"required":["adapter","source","subject"],
      "properties": {
        "adapter":{"type":"string","description":"the adapter of the collection plan that produced the source"},
        "source":{
          "type":"object","additionalProperties":false,"required":["content","sha256"],
          "properties": {
            "content":{"type":"string","description":"the retained bytes as utf-8: the command's stdout, or the canonical acquisition transcript for a remote plan"},
            "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
          }
        },
        "subject":{"$ref":"#/$defs/subject"}
      }
    },
    "evaluate_input": {
      "type":"object","additionalProperties":false,"required":["evaluator","corpus","target","evaluated_at","coverage"],
      "properties": {
        "evaluator":{"type":"string","description":"one of the evaluators the pack declared in describe"},
        "corpus":{"$ref":"evidence-corpus.schema.json","description":"the observations with the evaluator's declared claim keys, the collection runs for its declared propositions or behind those observations, and the sources the observations cite"},
        "target":{
          "type":"object","additionalProperties":false,"required":["repository","branch","release","from","until","mirror_of"],
          "properties": {
            "repository":{"type":"string"},
            "branch":{"type":"string"},
            "release":{"type":["string","null"]},
            "from":{"type":"string","format":"date-time"},
            "until":{"type":"string","format":"date-time"},
            "mirror_of":{"type":["string","null"]}
          }
        },
        "evaluated_at":{"type":"string","format":"date-time"},
        "coverage":{"type":"array","description":"core's coverage decision for each declared proposition","items":{"$ref":"derived-assertion.schema.json#/$defs/coverage"}}
      }
    },
    "subject": {
      "type":"object","required":["kind","id"],
      "description":"kind and id, with any qualifiers (branch, revision, release, ...) as further members",
      "properties": {"kind":{"type":"string"},"id":{"type":"string"}}
    },
    "interval": {"type":"object","additionalProperties":false,"required":["from","until"],"properties":{"from":{"type":"string","format":"date-time"},"until":{"type":"string","format":"date-time"}}}
  }
}
